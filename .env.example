# Optional: set secrets as environment variables instead of letting
# `autobuild init` store them in config/autobuild.secrets.env.
# Real environment variables take precedence over the secrets file.
REGISTRY_PASSWORD=          # registry token (GHCR: write:packages, Docker Hub: Read & Write)
GIT_TOKEN=                  # read access for private repos
WEBHOOK_SECRET=             # same value as the GitHub webhook secret
